#include "keys_ru.h"

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <200>;
    flavor = "tap-preferred";
    require-prior-idle-ms = <125>;
};

&caps_word { continue-list = <UNDERSCORE MINUS BACKSPACE DELETE LEFT RIGHT>; };

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        LBKT_COMBO {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
        };

        RBKT_COMBO {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
        };

        LSHIFT_COMBO {
            bindings = <&kp LSHFT>;
            key-positions = <20 21>;
        };

        NUBS_COMBO {
            bindings = <&kp BACKSLASH>;
            key-positions = <8 9>;
        };

        SQT_COMBO {
            bindings = <&kp SQT>;
            key-positions = <18 19>;
        };

        RSHIFT_COMBO {
            bindings = <&kp RSHFT>;
            key-positions = <28 29>;
        };

        right_control_combo {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <28 27>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q        &kp W        &kp E         &kp R         &kp T                                  &kp Y       &kp U         &kp I         &kp O             &kp P
  &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHFT F  &kp G                                  &kp H       &hmr RSHFT J  &hmr RCTRL K  &hmr RIGHT_ALT L  &hmr RGUI SEMICOLON
  &kp Z        &kp X        &kp C         &kp V         &kp B                                  &kp N       &kp M         &kp COMMA     &kp DOT           &kp SLASH
                                          &lt 4 ESC     &lt 1 DEL  &lt 2 SPACE    &lt 2 ENTER  &lt 1 BSPC  &lt 3 TAB
            >;

            label = "base";
            display-name = "#00ccff BASE";
        };

        mode {
            bindings = <
  &caps_word          &kp LC(PG_UP)               &kp LC(T)                   &kp LC(PAGE_DOWN)              &to 2                            &kp PG_UP      &kp HOME               &kp UP                   &kp END               &kp PSCRN
  &hml LEFT_GUI CAPS  &hml LEFT_ALT LA(LC(LEFT))  &hml LEFT_CONTROL LC(HOME)  &hml LEFT_SHIFT LA(LC(RIGHT))  &to 3                            &kp PG_DN      &hmr RIGHT_SHIFT LEFT  &hmr RIGHT_CONTROL DOWN  &hmr RIGHT_ALT RIGHT  &hmr RIGHT_GUI INS
  &kp KP_NUMLOCK      &kp LS(LC(PG_UP))           &kp LC(W)                   &kp LS(LC(PG_DN))              &to 4                            &kp LA(LEFT)   &kp LA(RIGHT)          &kp LC(LEFT)             &kp LC(RIGHT)         &kp GRAVE
                                                                              &kp ESC                        &kp DEL  &kp SPACE    &kp ENTER  &kp BACKSPACE  &kp TAB
            >;

            display-name = "#7fff00 MODE";
            label = "mode";
        };

        digits {
            bindings = <
  &kp F1            &kp F2            &kp F3                &kp F4              &to 0                            &kp N1         &kp N2               &kp N3                 &kp N4             &kp N5
  &hml LEFT_GUI F5  &hml LEFT_ALT F6  &hml LEFT_CONTROL F7  &hml LEFT_SHIFT F8  &to 3                            &kp N6         &hmr RIGHT_SHIFT N7  &hmr RIGHT_CONTROL N8  &hmr RIGHT_ALT N9  &hmr RIGHT_GUI N0
  &kp F9            &kp F10           &kp F11               &kp F12             &to 4                            &kp MINUS      &kp EQUAL            &kp DOT                &kp LEFT_BRACKET   &kp RIGHT_BRACKET
                                                            &kp ESC             &kp DEL  &kp SPACE    &kp ENTER  &kp BACKSPACE  &kp TAB
            >;

            display-name = "#d9dddc DIGITS";
            label = "digits";
        };

        system {
            bindings = <
  &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4                          &kp C_BRI_UP   &kp C_PP       &kp C_VOLUME_UP  &none       &none
  &out OUT_BLE    &out OUT_USB  &none         &bt BT_CLR_ALL  &bt BT_CLR                            &kp C_BRI_DN   &kp C_PREV     &kp C_VOL_DN     &kp C_NEXT  &none
  &kp LEFT_SHIFT  &none         &none         &none           &kp F23                               &kp F24        &kp LA(LC(M))  &kp C_MUTE       &none       &kp RIGHT_SHIFT
                                              &kp ESC         &kp DEL       &kp SPACE    &kp ENTER  &kp BACKSPACE  &kp TAB
            >;

            display-name = "#ff0800 SYSTEM";
            label = "system";
        };

        mouse {
            bindings = <
  &kp LEFT_ALT    &kp LC(PG_UP)      &kp LC(T)  &kp LC(PG_DN)      &to 2                            &msc SCRL_UP    &msc SCRL_LEFT  &mmv MOVE_UP    &msc SCRL_RIGHT  &kp RIGHT_ALT
  &kp LCTRL       &mkp RCLK          &mkp MCLK  &mkp LCLK          &to 3                            &msc SCRL_DOWN  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &kp RCTRL
  &kp LEFT_SHIFT  &kp LC(LS(PG_UP))  &kp LC(W)  &kp LS(LC(PG_DN))  &to 0                            &kp LEFT_GUI    &mkp LCLK       &mkp MCLK       &mkp RCLK        &kp RIGHT_SHIFT
                                                &kp ESC            &kp DEL  &kp SPACE    &kp ENTER  &kp BACKSPACE   &kp TAB
            >;

            label = "mouse";
            display-name = "#ffef00 MOUSE";
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
